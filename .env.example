# Copy to .env (local) or set in Netlify → Site configuration → Environment variables.
# All variables are optional. Only VITE_* variables are exposed to the browser,
# so never put private secrets here.

# Website name shown in the header, titles and footer
VITE_SITE_NAME="Legent TV"

# Public URL used for share links and SEO (no trailing slash)
VITE_SITE_URL="https://legenttv.netlify.app"

# Optional: load channels from a remote JSON file instead of src/data/channels.js
# The file must be a JSON array using the same fields as src/data/channels.js
VITE_CHANNELS_URL=""

# Contact email shown on the Contact page
VITE_CONTACT_EMAIL="hello@legenttv.example"
